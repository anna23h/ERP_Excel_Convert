<?xml version="1.0" encoding="UTF-8"?>
<!-- 样例：每周三 08:30 跑一次备货汇总（odoo_api/restock.py，经 run_weekly.sh）。
     周三而不是周一：周频供应商周二到货，周三跑时在手已含这批（ISSUES [备货提醒] A，2026-11-08 用户定）。
     Label / 文件名沿用旧库存周报的，已装过的机器 unload 后重新 cp + load 即可。
     安装：改下面两处路径 → cp 到 ~/Library/LaunchAgents/ → launchctl load。
     具体步骤见 odoo_api/README.md「部署」一节。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ihtct.stockreport</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGEME/projects/erp_excel_convert/odoo_api/run_weekly.sh</string>
    <!-- 口径（VO/GW 前缀、12 周、≥6 周有销、3/1 周备货）都是 restock.py 的默认值，不用再传参数。 -->
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>3</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <!-- 到点时机器睡着了就在唤醒后补跑一次。cron 没有这个行为，这也是选 launchd 的理由。 -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/CHANGEME/projects/erp_excel_convert/output/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/CHANGEME/projects/erp_excel_convert/output/launchd.err</string>
</dict>
</plist>
